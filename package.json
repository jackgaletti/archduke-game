{
  "name": "archduke-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "build": "npm run assets && tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "assets": "node scripts/assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server/server/main.js",
    "lint": "eslint src tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run validate:deployment && npm run test:e2e",
    "validate:deployment": "node scripts/validate-deployment.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.10.0",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "yaml": "2.9.1"
  }
}
